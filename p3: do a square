#Write a program to do a square using a while loop, doing steps with a for loop, changing directions based on a condition, and controlling
motor speed using switch case.

#Filename: Square.java

import ch.aplu.robotsim.*;

public class Square
{
    public Square()
    {
        TurtleRobot robot = new TurtleRobot();

        int i = 0;

        while (i < 4)
        {
            robot.forward(50);
            robot.right(90);

            i++;
        }

        robot.exit();
    }

    public static void main(String[] args)
    {
        new Square();
    }
}


#Filename: Steps.java

import ch.aplu.robotsim.*;

public class Steps
{
    public Steps()
    {
        TurtleRobot robot = new TurtleRobot();

        for (int i = 0; i < 4; i++)
        {
            robot.forward(20);
            robot.right(90);

            robot.forward(20);
            robot.left(90);
        }

        robot.exit();
    }

    public static void main(String[] args)
    {
        new Steps();
    }
}

#Filename: RandomMove.java
import ch.aplu.robotsim.*;

public class RandomMove
{
    public RandomMove()
    {
        TurtleRobot robot = new TurtleRobot();

        for (int i = 0; i < 7; i++)
        {
            double a = Math.random();

            if (a < 0.5)
            {
                robot.right(90);
            }
            else
            {
                robot.left(90);
            }

            robot.forward(100);
        }

        robot.exit();
    }

    public static void main(String[] args)
    {
        new RandomMove();
    }
}

#Filename: SpeedSwitch.java
import ch.aplu.robotsim.*;

public class SpeedSwitch
{
    public SpeedSwitch()
    {
        TurtleRobot robot = new TurtleRobot();

        for (int k = 1; k < 6; k++)
        {
            int speed;

            switch (k)
            {
                case 1:
                    speed = 20;
                    break;

                case 2:
                    speed = 40;
                    break;

                case 3:
                    speed = 60;
                    break;

                case 4:
                    speed = 80;
                    break;

                default:
                    speed = 50;
            }

            robot.setTurtleSpeed(speed);

            robot.forward(200);
            robot.right(90);
        }

        robot.exit();
    }

    public static void main(String[] args)
    {
        new SpeedSwitch();
    }
}
