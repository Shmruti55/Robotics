#Write a program to create a robot with two motors and move it forward, left, and right.

#Filename: Pract2.java

import ch.aplu.robotsim.*;

public class pract2
{
    public pract2()
    {
        LegoRobot robot = new LegoRobot();

        Motor motA = new Motor(MotorPort.A);
        Motor motB = new Motor(MotorPort.B);

        robot.addPart(motA);
        robot.addPart(motB);

        System.out.println("motA forward, motB forward");
        motA.forward();
        motB.forward();
        Tools.delay(2000);

        System.out.println("motA stop");
        motA.stop();
        Tools.delay(2000);

        System.out.println("motB stop");
        motB.stop();
        Tools.delay(2000);

        System.out.println("motA backward, motB forward");
        motA.backward();
        motB.forward();
        Tools.delay(2000);

        System.out.println("motA backward, motB backward");
        motB.backward();
        Tools.delay(2000);

        System.out.println("exiting");

        robot.exit();
    }

    public static void main(String[] args)
    {
        new pract2();
    }

    static
    {
        RobotContext.showStatusBar(30);
    }
}
